<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_pos_order_form_offline_sync" model="ir.ui.view">
        <field name="name">pos.order.form.inherit.offline_sync</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='pos_reference']" position="after">
                <field name="offline_uuid" readonly="1"/>
                <field name="offline_synced" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
